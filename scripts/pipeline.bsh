#!/bin/bash
# 1) Geometry stage: build adjacency list & energetics template
uv run python -m src.jump_network_builder\
	 examples/hcp_int_OT/input/hcp_int_OT.yaml \
	 examples/hcp_int_OT/input/cutoffs.yaml

# 2) Matrix stage: read YAML again, derive output_dir, and build matrices
uv run python -m src.matrix_builder.matrix_builder \
	 examples/hcp_int_OT/input/hcp_int_OT.yaml
